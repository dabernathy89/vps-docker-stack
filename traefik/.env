# .env (for Traefik stack)
# Store sensitive credentials and configuration here.
# This file should be sourced or its variables exported when running 'docker stack deploy'.
# IMPORTANT: Add this file to your .gitignore!

# Email address for Let's Encrypt registration and renewal notifications
LETSENCRYPT_EMAIL=your_email@example.com

# Optional: Define domain(s) if needed for dashboard rules etc. in traefik.yml or labels
# MY_DOMAIN1=domain1.com
# MY_DOMAIN2=domain2.com
