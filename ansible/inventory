# inventory
# Defines target hosts and variables for Ansible.
[vps]
# Replace with your VPS IP, SSH user, and path to your private key
your_vps_ip ansible_user=your_ssh_user ansible_ssh_private_key_file=~/.ssh/your_private_key

[vps:vars]
# User on the VPS that will run remote docker commands (must exist and have sudo/docker group access)
deploy_user=your_deploy_user
