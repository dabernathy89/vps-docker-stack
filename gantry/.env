# .env (for Gantry stack)
# Store sensitive credentials here.
# This file should be sourced or its variables exported when running 'docker stack deploy'.
# IMPORTANT: Add this file to your .gitignore!

# GitHub Container Registry Credentials
# Gantry uses these to authenticate when checking for new images.
GHCR_USER=YOUR_GITHUB_USERNAME
GHCR_PAT=YOUR_GITHUB_PAT # Your Personal Access Token with read:packages scope
